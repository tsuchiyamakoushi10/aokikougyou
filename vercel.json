{
  "framework": null,
  "installCommand": "npm install --omit=dev",
  "buildCommand": "echo static site",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/company/index.html",
      "destination": "/company/",
      "permanent": true
    },
    {
      "source": "/business/index02.html",
      "destination": "/business/automatic-door/",
      "permanent": true
    },
    {
      "source": "/business/index01.html",
      "destination": "/business/fittings/",
      "permanent": true
    },
    {
      "source": "/case/:path*",
      "destination": "/works/",
      "permanent": true
    },
    {
      "source": "/recruit/index.html",
      "destination": "/recruit/",
      "permanent": true
    },
    {
      "source": "/staff/index.html",
      "destination": "/staff/",
      "permanent": true
    },
    {
      "source": "/contact/index.html",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/entry/index.html",
      "destination": "/entry/",
      "permanent": true
    },
    {
      "source": "/cgi-bin/contact/:path*",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/cgi-bin/entry/:path*",
      "destination": "/entry/",
      "permanent": true
    },
    {
      "source": "/index.htm",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Reporting-Endpoints",
          "value": "csp=\"/api/csp-report\""
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw=' 'sha256-3u2VtgrFXP0aiWDaFMJrKjLD2zoSCAcbOuGQsWVtAJg=' 'sha256-6otzu6SEm1G32wJX44CI31ML9LNkW6GP409Faw9f0go=' 'sha256-HQ6wGfFSsJbz0g+K6OpcXls9SAg7qzOdhYEFLAvzRd4=' 'sha256-yEGyL1EaAPwWR5a/9CCCxw5rU3BM4vguiNRL2xnYuTo=' https://www.googletagmanager.com https://zipcloud.ibsnet.co.jp https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://*.g.doubleclick.net https://www.google.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.g.doubleclick.net https://www.google.com; frame-src https://www.google.com https://challenges.cloudflare.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests; report-uri /api/csp-report; report-to csp"
        }
      ]
    },
    {
      "source": "/wp-content/themes/aoki/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/wp-content/themes/aoki/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/wp-content/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(contact|entry)/thanks/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
