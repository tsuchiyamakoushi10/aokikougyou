{
  "framework": null,
  "installCommand": "npm install --omit=dev",
  "buildCommand": "echo static site",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/company/index.html",
      "destination": "/company/",
      "permanent": true
    },
    {
      "source": "/business/index02.html",
      "destination": "/business/automatic-door/",
      "permanent": true
    },
    {
      "source": "/business/index01.html",
      "destination": "/business/fittings/",
      "permanent": true
    },
    {
      "source": "/case/:path*",
      "destination": "/works/",
      "permanent": true
    },
    {
      "source": "/recruit/index.html",
      "destination": "/recruit/",
      "permanent": true
    },
    {
      "source": "/staff/index.html",
      "destination": "/staff/",
      "permanent": true
    },
    {
      "source": "/contact/index.html",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/entry/index.html",
      "destination": "/entry/",
      "permanent": true
    },
    {
      "source": "/cgi-bin/contact/:path*",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/cgi-bin/entry/:path*",
      "destination": "/entry/",
      "permanent": true
    },
    {
      "source": "/index.htm",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    },
    {
      "source": "/(contact|entry)/thanks/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}